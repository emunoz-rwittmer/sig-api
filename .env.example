# --- MySQL (Sequelize) ---
DB_NAME=
DB_USER=
DB_HOST=
DB_PORT=3306
DB_PASSWORD=

# --- MongoDB (Mongoose, session tokens) ---
DB_HOST_MONGO=
DB_USER_MONGO=
DB_PASSWORD_MONGO=
# Must match a database the Mongo user actually has a role on - verify with
# db.runCommand({connectionStatus:1, showPrivileges:true}) in mongosh before assuming
# the name. A mismatch here doesn't fail at boot; it only surfaces as a
# "not authorized" error the first time something writes (e.g. login persisting a
# refresh token), which will break every test that logs in.
DB_NAME_MONGO=

# --- Auth ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Hashids (ID obfuscation) ---
# PRODUCTION MUST use exactly: tiptop-hlfe/r0lf
# (this value is baked into previously issued encoded IDs, e.g. printed QR codes)
HASHIDS_SALT=

# --- Server ---
PORT=8000
NODE_ENV=development

# --- Swagger ---
# Only relevant when NODE_ENV=production. Leave unset/false to keep /api/docs off in prod.
SWAGGER_ENABLED=false

# --- Power BI reporting (embed + scheduled dataset refresh) ---
# Azure AD service principal with Power BI Service API permissions (Report.Read.All),
# admin-consented. See docs/superpowers/specs/2026-08-24-surveys-powerbi-reporting-design.md
# §6.3 in the interno-react repo for the manual Azure/Power BI setup steps.
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
# JSON map of reportKey -> {workspaceId, reportId}. Add an entry here (no code change)
# to expose a new report through GET /reports/powerbi/:reportKey/embed.
# Example: {"desempeno":{"workspaceId":"<guid>","reportId":"<guid>"}}
POWERBI_REPORTS_MAP=
# Static key Power BI Service must send as the X-PowerBI-Key header when it calls
# GET /reports/evaluations/powerbi-dataset for its scheduled refresh.
POWERBI_DATASET_API_KEY=
